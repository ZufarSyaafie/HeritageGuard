# Copy this file to .env.local on the EC2 server, then fill in real values.
# Do not commit the real .env.local file.

# NEXT_PUBLIC variables are included in browser-side JavaScript.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_HERITAGEGUARD_API_URL=

# Server-side only. Never expose this value in client components.
NEXT_SUPABASE_SERVICE_ROLE_KEY=

# Server-side inference endpoint used by src/lib/server/inference.js.
NEXT_HF_INFERENCE_URL=

# Server-side Cloudflare R2/S3-compatible storage configuration.
NEXT_R2_ENDPOINT=
NEXT_R2_ACCESS_KEY_ID=
NEXT_R2_SECRET_ACCESS_KEY=
NEXT_R2_BUCKET=
NEXT_R2_PUBLIC_BASE_URL=
